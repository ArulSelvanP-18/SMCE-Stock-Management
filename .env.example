SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Supabase (PostgreSQL) -------------------------------------------------
# Easiest: paste the full connection string from
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# (choose the "Session pooler" or "Transaction pooler" option, not the
# direct connection, for reliable access from most hosts).
# Example:
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- OR configure individually instead of DATABASE_URL --------------------
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=your_supabase_db_password
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require
